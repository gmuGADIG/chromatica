[gd_resource type="Resource" script_class="WorldCache" format=3 uid="uid://bigp7swogixhk"]

[sub_resource type="GDScript" id="GDScript_h2u8b"]
script/source = "extends Resource
class_name RoomData

@export var world_position : Vector2
@export var size : Vector2
@export var adjacent_rooms : Array[String]
"

[sub_resource type="Resource" id="Resource_h2u8b"]
script = SubResource("GDScript_h2u8b")
world_position = Vector2(5248, -1920)
size = Vector2(7296, 5248)
adjacent_rooms = Array[String](["0422f9d0-96d0-11f1-a239-d7fe97153aa0"])

[sub_resource type="Resource" id="Resource_vqip4"]
script = SubResource("GDScript_h2u8b")
size = Vector2(5248, 3328)
adjacent_rooms = Array[String](["394a8610-96d0-11f1-93be-9b3cf3013799"])

[sub_resource type="GDScript" id="GDScript_t1xd1"]
script/source = "extends Resource
class_name WorldCache


@export var room_data : Dictionary[String,RoomData]

func _init() -> void:
	pass

func add_room(level : LDTKLevel) -> void:
	var new_room : RoomData = RoomData.new()
	new_room.world_position = level.world_position
	new_room.size = level.size
	for key in level.neighbours:
		new_room.adjacent_rooms.append(key[\"levelIid\"])
	room_data.set(level.iid,new_room)
"

[resource]
script = SubResource("GDScript_t1xd1")
room_data = Dictionary[String, SubResource("GDScript_h2u8b")]({
"0422f9d0-96d0-11f1-a239-d7fe97153aa0": SubResource("Resource_vqip4"),
"394a8610-96d0-11f1-93be-9b3cf3013799": SubResource("Resource_h2u8b")
})
