; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Chromatica"
run/main_scene="uid://yqtxh6q1evc3"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://temp/temp_art/icon.svg"

[audio]

buses/default_bus_layout="uid://ddn7ru0dhkj34"

[editor_plugins]

enabled=PackedStringArray("res://addons/ldtk-importer/plugin.cfg")

[file_customization]

folder_colors={
"res://character/": "red",
"res://character/enemy/": "red",
"res://character/npc/": "orange",
"res://character/player/": "yellow",
"res://ldtk/": "yellow",
"res://systems/": "green",
"res://temp/": "gray",
"res://ui/": "teal",
"res://world/camera/": "red",
"res://world/decoration/": "orange",
"res://world/interactable/": "yellow",
"res://world/rooms/": "blue",
"res://world/rooms/test_rooms/": "gray"
}

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Player"
2d_physics/layer_3="Pickup"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=3
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
