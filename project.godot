; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Chromatica"
run/main_scene="uid://bv1fl583cdk3v"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://temp/temp_art/icon.svg"

[audio]

buses/default_bus_layout="uid://ddn7ru0dhkj34"

[display]

window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/ldtk-importer/plugin.cfg")

[file_customization]

folder_colors={
"res://character/": "red",
"res://character/enemy/": "red",
"res://character/enemy/Prototype Enemies/": "teal",
